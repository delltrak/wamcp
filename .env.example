# ============================================================
# WA MCP — Environment Variables
# ============================================================

# MCP Server Authentication
# API key for bearer token auth. If unset, no auth (dev mode).
# WA_MCP_API_KEY=wamcp_sk_your_secret_key_here

# Transport mode: "http" (Streamable HTTP) or "stdio" (local dev)
WA_TRANSPORT=http

# HTTP port for Streamable HTTP transport
WA_MCP_PORT=3000

# Redis connection URL (required for BullMQ queues)
WA_REDIS_URL=redis://localhost:6379

# Pino log level: debug | info | warn | error
WA_LOG_LEVEL=info

# Days to keep messages before auto-pruning
WA_MESSAGE_RETENTION_DAYS=30

# Automatically send read receipts: false (default), on_fetch, or on_receive
WA_AUTO_READ=false

# Max messages/minute per Baileys instance
WA_BAILEYS_RATE_LIMIT=20

# Max messages/minute per Cloud API instance
WA_CLOUD_RATE_LIMIT=80

# Meta webhook payload signing secret (Cloud API).
# Verifies the x-hub-signature-256 header on POST /cloud-webhook.
# WA_CLOUD_WEBHOOK_SECRET=your_meta_webhook_secret

# Meta webhook verification token (Cloud API).
# Required for Meta's GET verification handshake on POST /cloud-webhook.
# WA_CLOUD_VERIFY_TOKEN=your_meta_verify_token

# NOTE: the Cloud API webhook is served by the main MCP server on WA_MCP_PORT
# at POST /cloud-webhook. There is no separate webhook port.

# Outgoing normalized channel-event webhook (disabled when URL is unset)
# WA_EVENT_WEBHOOK_URL=https://automation.example.com/whatsapp-events
# Optional Grok Bot formatter and recommended incoming-message filters
# WA_EVENT_WEBHOOK_PRESET=grok-bot
# Comma-separated ChannelEvent names; defaults to message.received
# WA_EVENT_WEBHOOK_EVENTS=message.received
# Ignore messages sent by this WhatsApp instance (default: true)
WA_EVENT_WEBHOOK_IGNORE_FROM_ME=true
# Per-chat inbound message batching; 0 disables it (default: 0)
# New messages restart the window, up to the maximum wait from the first message.
# WA_WEBHOOK_DEBOUNCE_MS=2000
# Maximum total wait for a per-chat batch, 0-300000 ms (default: 30000)
# Values below WA_WEBHOOK_DEBOUNCE_MS are clamped to the debounce window.
# WA_WEBHOOK_DEBOUNCE_MAX_MS=30000
# Legacy destination-wide event debounce window (default: 0)
# WA_EVENT_WEBHOOK_DEBOUNCE_MS=2000
# Optional JSON object of additional request headers
# WA_EVENT_WEBHOOK_HEADERS={"Authorization":"Bearer replace-me"}
# Optional auth header; for Grok Bot the default name is X-Grok-Bot-Key.
# Copy the exact header name and key shown in the routine panel.
# WA_EVENT_WEBHOOK_AUTH_HEADER=X-Grok-Bot-Key
# WA_EVENT_WEBHOOK_AUTH_VALUE=your_grok_routine_key
# Optional HMAC-SHA256 request signing secret
# WA_EVENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# To configure multiple destinations, use WA_EVENT_WEBHOOKS instead of URL.
# Values such as authEnv and secretEnv reference environment variables below.
# WA_EVENT_WEBHOOKS=[{"id":"owner-routine","url":"https://hooks.example.com/routine","preset":"grok-bot","authHeader":"X-Grok-Bot-Key","authEnv":"GROK_ROUTINE_KEY","debounceMs":2000}]
# GROK_ROUTINE_KEY=your_grok_routine_key
# HTTP permits only the http scheme; DNS answers for private/local targets stay blocked
WA_EVENT_WEBHOOK_ALLOW_HTTP=false
# Queue namespace defaults to a hash of WA_DEPLOYMENT_ID, HOSTNAME, or the OS hostname.
# Set the same value on replicas of one deployment and a unique value per deployment.
# WA_EVENT_WEBHOOK_QUEUE_PREFIX=production-wamcp
WA_EVENT_WEBHOOK_TIMEOUT_MS=10000
WA_EVENT_WEBHOOK_RETRY_ATTEMPTS=5
WA_EVENT_WEBHOOK_RETRY_DELAY_MS=1000

# Max media cache size in MB before cleanup
WA_MEDIA_CACHE_MAX_MB=500
# Directory for received media files (separate from Baileys session data)
WA_MEDIA_DOWNLOAD_DIR=data/media-downloads
# Maximum received media download size (default 25 MB); base64 mode is capped at 5 MB
WA_MEDIA_DOWNLOAD_MAX_BYTES=26214400
# Optional ffmpeg executable for sticker and GIF conversion; Docker includes ffmpeg
# WA_MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
WA_MEDIA_FFMPEG_TIMEOUT_MS=60000

# Incoming audio transcription (disabled unless explicitly enabled)
WA_TRANSCRIPTION_ENABLED=false
# WA_TRANSCRIPTION_API_KEY=your_transcription_api_key
WA_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
WA_TRANSCRIPTION_MODEL=whisper-1
# Optional ISO-639-1 language hint, e.g. en
# WA_TRANSCRIPTION_LANGUAGE=en
WA_TRANSCRIPTION_MAX_MB=16
WA_TRANSCRIPTION_TIMEOUT_MS=60000
# Maximum concurrent incoming audio downloads and transcriptions (default: 2)
TRANSCRIPTION_CONCURRENCY=2

# Outgoing text-to-speech voice notes (disabled unless explicitly enabled)
WA_TTS_ENABLED=false
WA_TTS_PROVIDER=elevenlabs
# WA_TTS_API_KEY=
# WA_TTS_DEFAULT_VOICE_ID=
WA_TTS_MODEL=eleven_v3
# Optional ISO-639-1 language hint, e.g. en
# WA_TTS_LANGUAGE=
WA_TTS_OUTPUT_FORMAT=opus_48000_64
WA_TTS_MAX_CHARS=5000
WA_TTS_BASE_URL=https://api.elevenlabs.io
WA_TTS_TIMEOUT_MS=60000
# Maximum simultaneous TTS synthesis and ffmpeg conversions (default: 2)
TTS_CONCURRENCY=2
# Optional absolute path; defaults to ffmpeg from PATH
# WA_TTS_FFMPEG_PATH=/usr/bin/ffmpeg

# Auto-reconnect Baileys instances on disconnect
WA_AUTO_RECONNECT=true

# Mark a Baileys account online as soon as its socket connects (default: false)
# WA_MARK_ONLINE_ON_CONNECT=false

# Maximum recipients in a Baileys status audience (default: 256).
# If an audience is larger, the status is sent to the first capped recipients
# and the tool response reports the omitted recipient count and warning.
WA_STATUS_MAX_RECIPIENTS=256

# Daily WhatsApp Web version auto-check
WA_VERSION_CHECK=true
