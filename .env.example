# ============================================================
# WA MCP — Environment Variables
# ============================================================

# MCP Server Authentication
# API key for bearer token auth. If unset, no auth (dev mode).
# WA_MCP_API_KEY=wamcp_sk_your_secret_key_here

# Operations dashboard. Off by default. Requires WA_TRANSPORT=http.
# When enabled, WA_DASHBOARD_USERS is required. Comma-separated user:password
# entries. A password must be at least 12 characters, may contain colons, and
# must not contain commas. Basic auth repeats the password on every request,
# so terminate TLS in front of the server. Failures are counted per address
# and username, and per address across usernames. Eight wrong Authorization
# headers in 15 minutes return 401. Further guesses return 429. A correct
# login does not clear failures, so polling does not refresh an attacker's
# guesses. A username that signed in during the last 15 minutes skips the
# address total and the process-wide cap until that username fails again.
# Eight failures of that same username still limit it. While limited, one
# password check per address is allowed each 60 seconds, and an attacker on
# that address can take it. Failed password checks are capped at 60 per minute
# for the process. Successful checks are not counted. During a distributed
# attack, a correct login from a username that has not signed in during the
# last 15 minutes can also return 429. A request with no Authorization header
# is not counted.
# IPv6 clients share a counter per /64. The page is
# read-only except starting pairing for an existing Baileys instance that is
# not already paired. It does not create instances, and it does not change the
# database path, Baileys auth store, or Docker volumes.
WA_DASHBOARD_ENABLED=false
# WA_DASHBOARD_USERS=operator:replace-with-a-long-password

# Transport mode: "http" (Streamable HTTP) or "stdio" (local dev)
WA_TRANSPORT=http

# HTTP port for Streamable HTTP transport
WA_MCP_PORT=3000

# Redis connection URL (required for BullMQ queues)
WA_REDIS_URL=redis://localhost:6379

# Pino log level: debug | info | warn | error
WA_LOG_LEVEL=info

# Days to keep messages before auto-pruning
WA_MESSAGE_RETENTION_DAYS=30

# SQLite database path (relative to the app directory unless absolute)
WA_DATABASE_PATH=data/whatsapp.db
# Maximum messages requested per chat by automatic and on-demand history fetches (1-10000)
WA_BAILEYS_HISTORY_SYNC_MAX_MESSAGES=100
# Optional Docker Compose host directory mounted at /app/data. Unset keeps the existing wa-data volume.
# WA_DATA_DIR=/srv/wamcp-data

# Automatically send read receipts: false (default), on_fetch, or on_receive
WA_AUTO_READ=false
# After a stored incoming audio message is transcribed, send a played receipt (default: false).
# wa_mark_played is always available and does not depend on this flag.
WA_AUTO_MARK_PLAYED=false

# Fixed auto-reply. Off unless WA_AUTO_REPLY_ENABLED=true.
# Other WA_AUTO_REPLY_* values are read only when this is true.
# Replies are queued. The account never answers itself, its own phone or LID,
# groups (unless WA_AUTO_REPLY_GROUPS=true), hosted chats, status broadcasts,
# newsletters, reactions, empty or protocol messages, or ignored JIDs.
# The cooldown is stored per private contact, or per group, and kept across restarts.
# A per-minute cap also applies.
# In on_activity presence mode each reply briefly shows the account online.
WA_AUTO_REPLY_ENABLED=false
# WA_AUTO_REPLY_TEXT=Thanks, I will reply soon.
# Minimum time between replies to the same contact, 1-8760 hours (default 24).
# The timestamp is stored in SQLite. Private chats share one key across PN/LID aliases.
# Groups use the group JID, so one reply covers every sender in that group.
WA_AUTO_REPLY_COOLDOWN_HOURS=24
# Skip messages with no timestamp or older than this many seconds (default 180, range 30-3600).
WA_AUTO_REPLY_MAX_AGE_SECONDS=180
# Comma-separated chats or senders to skip. Blank ignores nothing.
# A device suffix such as :12 is ignored. The user and the domain are matched separately.
# Patterns without @, such as 5577*, match only @s.whatsapp.net (and the resolved phone of an @lid).
# A domain suffix such as @lid or @g.us matches the chat. In a group it also matches the sender.
# It does not match the other alias, so @lid leaves a phone chat alone.
# Exact JIDs still match every alias. Accepted domains: s.whatsapp.net, lid, g.us, broadcast,
# newsletter, hosted, hosted.lid. Other domains, and s.whatsapp.net without @, are rejected.
WA_AUTO_REPLY_IGNORE_JIDS=
WA_AUTO_REPLY_GROUPS=false
# Maximum auto-replies per instance in a rolling minute, 1-30 (default 6)
WA_AUTO_REPLY_RATE_PER_MINUTE=6
# Comma-separated instance ids. Blank replies on every instance.
# WA_AUTO_REPLY_INSTANCES=

# Protected Baileys app-state patches and remaining gated account/server changes (default: false).
# Gated tools: wa_archive_chat, wa_pin_chat, wa_mute_chat, wa_delete_chat, wa_clear_chat,
# wa_mark_chat_unread, wa_star_message, wa_create_label, wa_edit_label, wa_delete_label,
# wa_add_chat_label, wa_remove_chat_label, wa_add_message_label, wa_remove_message_label,
# wa_update_profile_name, wa_create_quick_reply, wa_edit_quick_reply, wa_delete_quick_reply,
# wa_create_community, wa_community_link_group, wa_community_unlink_group, wa_leave_community,
# wa_newsletter_follow, wa_newsletter_unfollow, wa_create_newsletter,
# wa_newsletter_update_name, wa_newsletter_update_description,
# wa_newsletter_update_picture, wa_newsletter_react, wa_create_catalog_product,
# wa_update_catalog_product, wa_delete_catalog_products, wa_group_join_approval_mode,
# wa_group_member_add_mode, wa_set_disappearing_messages, wa_create_group,
# wa_group_update_subject, wa_group_update_description, wa_group_update_settings, wa_group_leave,
# wa_group_revoke_invite, wa_group_toggle_ephemeral, wa_group_join,
# wa_group_add_participants, wa_group_remove_participants, wa_group_promote, wa_group_demote,
# wa_group_update_picture, wa_group_remove_picture, wa_group_handle_request,
# and wa_create_group_from_group.
# wa_update_privacy is gated only for the defaultDisappearingMode setting.
WA_APP_STATE_WRITES_ENABLED=false
# Baileys group/community/Channel server writes, including member labels (default: false).
WA_GROUP_WRITES_ENABLED=false
# Automatically DM a new group member a local history digest after a GROUP_PARTICIPANT_ADD
# stub authored by this account. Requires WA_GROUP_WRITES_ENABLED=true. Only true or false;
# any other value fails startup. Invite stubs are skipped. rc14 does not mark approved join
# requests, so an approval delivered as a plain add stub authored by this account is sent.
WA_GROUP_HISTORY_ON_JOIN=false
# Integer count of recent local messages in an automatic digest. Values outside 25-100 are
# clamped. A non-integer fails startup.
WA_GROUP_HISTORY_ON_JOIN_COUNT=50
# Minimum spacing between app-state write attempts in milliseconds; 0 disables spacing.
WA_APP_STATE_MIN_INTERVAL_MS=1500

# Max messages/minute per Baileys instance
WA_BAILEYS_RATE_LIMIT=20

# Optional outbound proxy for the Baileys WhatsApp WebSocket and media transfers.
# Unset or empty keeps a direct connection. Schemes: socks5, socks5h, http, https.
# An explicit port is required. A path, query, or fragment is rejected.
# Credentials are allowed and are removed from logs, agent-visible errors, and GET /health.
# An invalid value stops the process at startup.
# WA_PROXY_URL=socks5://user:pass@proxy.example:1080

# Max messages/minute per Cloud API instance
WA_CLOUD_RATE_LIMIT=80

# Meta webhook payload signing secret (Cloud API).
# Verifies the x-hub-signature-256 header on POST /cloud-webhook.
# WA_CLOUD_WEBHOOK_SECRET=your_meta_webhook_secret

# Meta webhook verification token (Cloud API).
# Required for Meta's GET verification handshake on POST /cloud-webhook.
# WA_CLOUD_VERIFY_TOKEN=your_meta_verify_token

# NOTE: the Cloud API webhook is served by the main MCP server on WA_MCP_PORT
# at POST /cloud-webhook. There is no separate webhook port.

# Outgoing normalized channel-event webhook (disabled when URL is unset)
# WA_EVENT_WEBHOOK_URL=https://automation.example.com/whatsapp-events
# Refuse to start when neither a global destination nor a per-instance webhook
# is configured, or when the event set is empty (default: false).
# One stored instance webhook satisfies this check for the whole process.
WA_REQUIRE_EVENT_WEBHOOK=false
# false replaces global destinations for that instance only.
# true also delivers to the global destinations. The same URL is sent once.
# The URL, auth header, and events are stored with wa_set_instance_webhook.
# auth_value is stored in plaintext. Delivery signs with WA_EVENT_WEBHOOK_SECRET
# when that global HMAC secret is set. Different secrets across global destinations
# leave an unmatched instance URL unsigned, and that warning is logged once.
WA_EVENT_WEBHOOK_INSTANCE_MERGE_GLOBAL=false
# The three instance webhook tools are unregistered unless this is true (default: false).
WA_INSTANCE_WEBHOOK_TOOLS_ENABLED=false
# Optional comma-separated hosts for wa_set_instance_webhook. Unset allows any public host.
# WA_INSTANCE_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# Optional Grok Bot message formatter, incoming-message filters, and lifecycle summaries
# WA_EVENT_WEBHOOK_PRESET=grok-bot
# Comma-separated ChannelEvent names; defaults to message.received
# Optional, off unless listed: group.joined, label.association,
# newsletter.joined, newsletter.left, newsletter.message, newsletter.mute
# WA_EVENT_WEBHOOK_EVENTS=message.received
# Ignore messages sent by this WhatsApp instance (default: true)
WA_EVENT_WEBHOOK_IGNORE_FROM_ME=true
# Optional comma-separated JID ignore list (#140). Unset or empty forwards every chat.
# @-prefixed entries match only the chat JID (@g.us, @s.whatsapp.net, @lid,
# @newsletter, @broadcast, @c.us). *@domain is stored as that same @domain wildcard.
# Exact JIDs and one * in the user part also match the sender and LID aliases.
# Matching ignores case and a :device suffix.
# A trailing comma is skipped. A LID-only chat also checks the stored contact phone.
# WA_EVENT_WEBHOOK_IGNORE_JIDS=@g.us,5577*@s.whatsapp.net,5511888888888@s.whatsapp.net
# Per-chat inbound message batching; 0 disables it (default: 0)
# New messages restart the window, up to the maximum wait from the first message.
# WA_WEBHOOK_DEBOUNCE_MS=2000
# Maximum total wait for a per-chat batch, 0-300000 ms (default: 30000)
# Values below WA_WEBHOOK_DEBOUNCE_MS are clamped to the debounce window.
# WA_WEBHOOK_DEBOUNCE_MAX_MS=30000
# Legacy destination-wide event debounce window (default: 0)
# WA_EVENT_WEBHOOK_DEBOUNCE_MS=2000
# Optional JSON object of additional request headers
# WA_EVENT_WEBHOOK_HEADERS={"Authorization":"Bearer replace-me"}
# Optional auth header; for Grok Bot the default name is X-Grok-Bot-Key.
# Copy the exact header name and key shown in the routine panel.
# WA_EVENT_WEBHOOK_AUTH_HEADER=X-Grok-Bot-Key
# WA_EVENT_WEBHOOK_AUTH_VALUE=your_grok_routine_key
# Optional HMAC-SHA256 request signing secret
# WA_EVENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# To configure multiple destinations, use WA_EVENT_WEBHOOKS instead of URL.
# Values such as authEnv and secretEnv reference environment variables below.
# WA_EVENT_WEBHOOKS=[{"id":"owner-routine","url":"https://hooks.example.com/routine","preset":"grok-bot","authHeader":"X-Grok-Bot-Key","authEnv":"GROK_ROUTINE_KEY","debounceMs":2000}]
# GROK_ROUTINE_KEY=your_grok_routine_key
# HTTP permits only the http scheme; DNS answers for private/local targets stay blocked
WA_EVENT_WEBHOOK_ALLOW_HTTP=false
# Queue namespace defaults to a hash of WA_DEPLOYMENT_ID, HOSTNAME, or the OS hostname.
# Set the same value on replicas of one deployment and a unique value per deployment.
# WA_EVENT_WEBHOOK_QUEUE_PREFIX=production-wamcp
WA_EVENT_WEBHOOK_TIMEOUT_MS=10000
WA_EVENT_WEBHOOK_RETRY_ATTEMPTS=5
WA_EVENT_WEBHOOK_RETRY_DELAY_MS=1000

# Max media cache size in MB before cleanup
WA_MEDIA_CACHE_MAX_MB=500
# Directory for received media files (separate from Baileys session data)
WA_MEDIA_DOWNLOAD_DIR=data/media-downloads
# Maximum received media download size (default 25 MB); base64 mode is capped at 5 MB
WA_MEDIA_DOWNLOAD_MAX_BYTES=26214400
# Optional ffmpeg executable for sticker conversion, GIF conversion, and opt-in compression.
# Docker installs Alpine ffmpeg (libwebp, libwebp_anim, mjpeg, libx264, aac). Sharp is not used.
# WA_MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
WA_MEDIA_FFMPEG_TIMEOUT_MS=60000
# Image and video compression is off unless this is true. Per-call compress/hd overrides it.
# Invalid values are rejected. hd true on wa_send_image or wa_send_video sends the original.
WA_MEDIA_COMPRESS=false
# Longest edge for compressed images, from 16 to 4096
WA_MEDIA_IMAGE_MAX_EDGE=600
# JPEG quality for compressed images, from 1 to 100 (100 is best)
WA_MEDIA_IMAGE_QUALITY=75
# Longest edge for compressed videos, from 16 to 4096
WA_MEDIA_VIDEO_MAX_EDGE=720
# libx264 CRF for compressed videos, from 0 to 51 (lower is higher quality)
WA_MEDIA_VIDEO_CRF=28

# Incoming audio transcription (disabled unless explicitly enabled)
WA_TRANSCRIPTION_ENABLED=false
# WA_TRANSCRIPTION_API_KEY=your_transcription_api_key
WA_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
WA_TRANSCRIPTION_MODEL=whisper-1
# Optional ISO-639-1 language hint, e.g. en
# WA_TRANSCRIPTION_LANGUAGE=en
WA_TRANSCRIPTION_MAX_MB=16
WA_TRANSCRIPTION_TIMEOUT_MS=60000
# Maximum concurrent incoming audio downloads and transcriptions (default: 2)
TRANSCRIPTION_CONCURRENCY=2

# Outgoing text-to-speech voice notes (disabled unless explicitly enabled)
WA_TTS_ENABLED=false
WA_TTS_PROVIDER=elevenlabs
# WA_TTS_API_KEY=
# WA_TTS_DEFAULT_VOICE_ID=
WA_TTS_MODEL=eleven_v3
# Optional ISO-639-1 language hint, e.g. en
# WA_TTS_LANGUAGE=
WA_TTS_OUTPUT_FORMAT=opus_48000_64
WA_TTS_MAX_CHARS=5000
WA_TTS_BASE_URL=https://api.elevenlabs.io
WA_TTS_TIMEOUT_MS=60000
# Maximum simultaneous TTS synthesis and ffmpeg conversions (default: 2)
TTS_CONCURRENCY=2
# Optional absolute path; defaults to ffmpeg from PATH
# WA_TTS_FFMPEG_PATH=/usr/bin/ffmpeg

# Auto-reconnect Baileys instances on disconnect
WA_AUTO_RECONNECT=true

# Automatically reject incoming one-to-one Baileys call offers (default: false).
# Call offer/reject/timeout updates are emitted as whatsapp/call.received events.
WA_AUTO_REJECT_CALLS=false

# Keep Baileys presence available only around sends and typing/recording activity
# (default: on_activity; use always for the legacy mark-online behavior)
WA_PRESENCE_MODE=on_activity
# Seconds to stay available after the last send or typing/recording indicator (default: 30, max: 2147483)
WA_PRESENCE_IDLE_SECONDS=30
# In always mode, optionally mark a Baileys account online as soon as its socket connects
# WA_MARK_ONLINE_ON_CONNECT=false

# Briefly mark each connected Baileys account available inside a daily window (default: false).
# Does not change WA_MARK_ONLINE_ON_CONNECT and does not use app-state writes.
# Cloud API instances are skipped. A restart plans the day again. Slots within 3 minutes of
# startup are skipped. A spring-forward day that no longer fits the pulses is skipped too.
# In always mode with WA_MARK_ONLINE_ON_CONNECT=true the account is already online, so the pulse
# does not run. Otherwise a pulse sends unavailable at the end only when that pulse made it available.
WA_PRESENCE_PULSE_ENABLED=false
# How many times per day to go online. Integer 1-12. Default: 2.
# Pulses stay at least 15 minutes apart after each one ends.
WA_PRESENCE_PULSE_TIMES_PER_DAY=2
# How many minutes each pulse stays available. Integer 1-15. Default: 5.
WA_PRESENCE_PULSE_MINUTES=5
# Wall-clock window HH:MM-HH:MM in WA_PRESENCE_PULSE_TZ. Must end after it starts. Default: 08:00-22:00.
WA_PRESENCE_PULSE_WINDOW=08:00-22:00
# IANA time zone for the window. Unset uses the process TZ, or the server's local zone when TZ is unset.
# A container without TZ runs in UTC. WA_PRESENCE_PULSE_TZ=America/Bahia
# TZ=America/Bahia

# Maximum recipients in a Baileys status audience (default: 256).
# If an audience is larger, the status is sent to the first capped recipients
# and the tool response reports the omitted recipient count and warning.
WA_STATUS_MAX_RECIPIENTS=256

# Daily WhatsApp Web version auto-check
WA_VERSION_CHECK=true

# Chatwoot API-channel bridge (off by default). Sending agent replies is a
# WhatsApp write, and inbound sync runs only while this flag is true.
# It does not change WA_EVENT_WEBHOOK_* delivery.
WA_CHATWOOT_ENABLED=false
# WA_CHATWOOT_URL=https://chatwoot.example.com
# WA_CHATWOOT_TOKEN=your_chatwoot_api_access_token
# Numeric Chatwoot account id from /app/accounts/<id>/...
# WA_CHATWOOT_ACCOUNT_ID=1
# Numeric API-channel inbox id
# WA_CHATWOOT_INBOX_ID=1
# Required when enabled. At least 16 characters. Chatwoot v4.13+ signs the raw body
# as HMAC-SHA256(secret, "<X-Chatwoot-Timestamp>.<raw body>") and sends
# X-Chatwoot-Signature, X-Chatwoot-Timestamp, and X-Chatwoot-Delivery.
# Chatwoot generates this value for the API inbox. Copy it here. Do not put it in the URL.
# WA_CHATWOOT_WEBHOOK_SECRET=replace-with-the-chatwoot-generated-secret
# Off by default. Accepts ?secret= and the older X-Chatwoot-Webhook-Secret headers.
WA_CHATWOOT_ALLOW_LEGACY_SECRET=false
# Drop agent replies that would be sent to a group.
WA_CHATWOOT_BLOCK_GROUP_REPLIES=false
# Comma-separated JID filter. Exact JIDs, @domain suffixes, or * wildcards.
# status@broadcast, @broadcast, and @newsletter are always ignored.
# WA_CHATWOOT_IGNORE_JIDS=@g.us,15551234567@s.whatsapp.net
# Optional. When set, only this instance is synced and used for agent replies.
# WA_CHATWOOT_INSTANCE_ID=inst_0123abcd
# Allow http:// for a Chatwoot URL. Private and loopback hosts stay blocked.
WA_CHATWOOT_ALLOW_HTTP=false
# Allow a private Chatwoot hostname (self-hosted). Link-local and metadata addresses stay blocked.
WA_CHATWOOT_ALLOW_PRIVATE_URL=false
WA_CHATWOOT_TIMEOUT_MS=10000
